{
  "name": "wobble-tide-brainrots",
  "tree": {
    "$className": "DataModel",
    "Players": {
      "$properties": {
        "CharacterAutoLoads": true
      }
    },
    "ReplicatedFirst": {
      "$path": "src/client"
    },
    "ReplicatedStorage": {
      "$path": "src/shared"
    },
    "ServerScriptService": {
      "$path": "src/boot",
      "BaseService": { "$path": "src/server/BaseService.luau" },
      "BrainrotMarket": { "$path": "src/server/BrainrotMarket.luau" },
      "PlayerState": { "$path": "src/server/PlayerState.luau" },
      "ThreatDirector": { "$path": "src/server/ThreatDirector.luau" }
    },
    "ServerStorage": {
      "WorldBuilder": {
        "$path": "src/server/WorldBuilder.luau",
        "BrainrotBuilder": { "$path": "src/server/BrainrotBuilder.luau" }
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [0.45, 0.45, 0.5],
        "OutdoorAmbient": [0.6, 0.6, 0.65],
        "Brightness": 3,
        "ClockTime": 14.5,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "ShadowMap"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
